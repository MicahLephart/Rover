<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>moon_rover_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 vehicle nodes (collector and hauler rover) that mirror and drive the rovers in the Gazebo moon.sdf world.</description>
  <maintainer email="micahlephart@gmail.com">MicahLephart</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
